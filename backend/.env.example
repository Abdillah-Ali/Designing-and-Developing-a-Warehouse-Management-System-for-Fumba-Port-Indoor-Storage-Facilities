# Fumba Port WMS backend environment reference.
# Copy this file to backend/.env for local backend development only.
# Docker Compose reads its database credentials from the repository-root .env;
# do not add POSTGRES_DB, POSTGRES_USER, or POSTGRES_PASSWORD to this file.

# Required backend runtime settings.
PORT=5000
DB_HOST=localhost
DB_PORT=5432
DB_NAME=fumbaport_wms
DB_USER=postgres
DB_PASSWORD=replace-with-secure-database-password
CORS_ORIGIN=https://wms.example.invalid
# Production TLS is terminated by a trusted reverse proxy which must set X-Forwarded-Proto=https.
JWT_SECRET=replace-with-at-least-32-random-characters

# Optional local development settings.
# Set CORS_ORIGIN to one or more comma-separated frontend origins when needed.
CORS_ORIGIN=http://localhost:3000
NODE_ENV=development
JWT_EXPIRES_IN=24h
LOGIN_RATE_LIMIT_WINDOW_MS=120000
LOGIN_RATE_LIMIT_MAX=3
DB_POOL_MAX=10
DB_IDLE_TIMEOUT_MS=30000
DB_CONNECTION_TIMEOUT_MS=5000
PERMISSION_CACHE_TTL_MS=60000

# Optional cargo-document storage settings used only by the backend.
# Leave CARGO_DOCUMENT_UPLOAD_ROOT empty to use the application's default upload location.
CARGO_DOCUMENT_UPLOAD_ROOT=
CARGO_DOCUMENT_MAX_BYTES=10485760
CARGO_DOCUMENT_TYPES_JSON={"application/pdf":".pdf","application/vnd.openxmlformats-officedocument.wordprocessingml.document":".docx","image/jpeg":".jpg","image/png":".png"}

# Optional role-label overrides. Omit or leave empty to use the built-in defaults.
SYSTEM_ADMIN_ROLE_NAME=System Admin
WAREHOUSE_STAFF_ROLE_NAME=Warehouse Staff
WAREHOUSE_SUPERVISOR_ROLE_NAME=Supervisor
FINANCE_OFFICER_ROLE_NAME=Finance Officer
CUSTOMS_OFFICER_ROLE_NAME=Customs Officer
GATE_OFFICER_ROLE_NAME=Gate Officer
MANAGEMENT_ROLE_NAME=Management
SCANNER_ROLE_NAME=Scanner

# Optional JSON overrides. Leave empty to use built-in application defaults.
WMS_ROLE_DEFINITIONS_JSON=
WMS_DEFAULT_SHIFTS_JSON=
WMS_REJECTION_CONDITIONS_JSON={"DUPLICATE_REGISTRATION":"Duplicate cargo registration exists.","MISSING_DOCUMENTS":"Required documents are missing.","FRAUDULENT_INFORMATION":"Cargo information is fraudulent or intentionally incorrect.","OWNERSHIP_UNVERIFIED":"Consignee or ownership cannot be verified.","PROHIBITED_CARGO":"Cargo is prohibited from warehouse storage.","SAFETY_RISK":"Cargo condition creates a safety risk.","INVALID_HAZARD_CLASSIFICATION":"Hazardous cargo classification is missing or invalid.","REGISTERED_IN_ERROR":"Cargo was registered in error and should not exist in the system."}

# Flutterwave v4 Sandbox (backend only; never expose these values to React).
PAYMENT_PROVIDER=flutterwave
PAYMENT_ENVIRONMENT=sandbox
FLUTTERWAVE_API_BASE_URL=https://developersandbox-api.flutterwave.com
FLUTTERWAVE_OAUTH_TOKEN_URL=https://idp.flutterwave.com/realms/flutterwave/protocol/openid-connect/token
FLUTTERWAVE_CLIENT_ID=
FLUTTERWAVE_CLIENT_SECRET=
FLUTTERWAVE_WEBHOOK_SECRET=
PAYMENT_CALLBACK_URL=http://localhost:3000/finance/payments/return
PAYMENT_WEBHOOK_URL=

# Test-only switch. Do not set this in local development, Docker, or production.
# ALLOW_TEST_ENV_DEFAULTS=false
