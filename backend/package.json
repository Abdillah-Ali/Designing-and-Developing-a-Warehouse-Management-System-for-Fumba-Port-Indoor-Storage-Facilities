{
  "name": "fumbaport-wms-backend",
  "version": "1.0.0",
  "description": "Fumba Port Warehouse Management System backend API",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "init-db": "node database/initDb.js",
    "migrate": "node database/updateSchema.js",
    "verify-schema": "node database/verifySchema.js",
    "seed:warehouses": "node database/seedRealWarehouseHierarchy.js",
    "seed:cleanup": "node database/cleanupSeededData.js",
    "test": "node --import ./tests/testTeardown.js --test --test-isolation=none --test-concurrency=1 tests/*.test.js"
  },
  "keywords": [
    "warehouse",
    "wms",
    "express",
    "postgresql"
  ],
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "nodemailer": "^9.1.0",
    "pg": "^8.13.1",
    "socket.io": "^4.8.3"
  },
  "devDependencies": {
    "nodemon": "^3.1.9"
  }
}
